{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Launcher",
  "identifier": "dev.noah.gamelauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Game Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TheBiemGamer",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/TheBiemGamer/game-launcher/releases/latest/download/latest.json"]
    }
  }
}
